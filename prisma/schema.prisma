// Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  SAAS
  WEBSITE
  ECOMMERCE
  FULLSTACK
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String
  description String   @db.Text
  category    Category @default(FULLSTACK)
  client      String?
  role        String
  year        String
  imageUrl    String
  gallery     String[] @default([])
  techStack   String[] @default([])
  liveUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  challenge   String?  @db.Text
  solution    String?  @db.Text
  results     String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([category])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  budget    String?
  service   String?
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
}
